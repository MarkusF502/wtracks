<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: a sessão MultiTracks cifrada pelo Keystore não vai para a nuvem nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wtracks_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wtracks_secure.xml" />
    </device-transfer>
</data-extraction-rules>
